{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "x86-ninja",
      "displayName": "MSVC x86 / Ninja (run from an x86 developer shell: vcvarsamd64_x86.bat or x86 Native Tools prompt)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/x86-ninja",
      "architecture": { "value": "x86", "strategy": "external" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "NTW2_BUILD_RUNTIME": "ON",
        "NTW2_BUILD_TESTS": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "x86-ninja-tests",
      "displayName": "MSVC x86 / Ninja, product + native oracles/harnesses/audits",
      "inherits": "x86-ninja",
      "binaryDir": "${sourceDir}/build/x86-ninja-tests",
      "cacheVariables": { "NTW2_BUILD_TESTS": "ON" }
    },
    {
      "name": "vs2026-x86",
      "displayName": "Visual Studio 2026 / Win32",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/vs2026-x86",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": {
        "NTW2_BUILD_RUNTIME": "ON",
        "NTW2_BUILD_TESTS": "OFF"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "vs2026-x86-tests",
      "displayName": "Visual Studio 2026 / Win32, product + native oracles/harnesses/audits",
      "inherits": "vs2026-x86",
      "binaryDir": "${sourceDir}/build/vs2026-x86-tests",
      "cacheVariables": { "NTW2_BUILD_TESTS": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "x86-ninja", "configurePreset": "x86-ninja" },
    { "name": "x86-ninja-tests", "configurePreset": "x86-ninja-tests" },
    { "name": "vs2026-x86", "configurePreset": "vs2026-x86", "configuration": "Release" },
    { "name": "vs2026-x86-tests", "configurePreset": "vs2026-x86-tests", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "x86-ninja-tests",
      "configurePreset": "x86-ninja-tests",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "vs2026-x86-tests",
      "configurePreset": "vs2026-x86-tests",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
